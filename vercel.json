{
  "version": 2,
  "builds": [
    {
      "src": "api/wishes.js",
      "use": "@vercel/node"
    },
    {
      "src": "form.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/form.html"
    }
  ]
}
